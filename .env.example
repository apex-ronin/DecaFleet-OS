# TYPESAFE_API_KEY: Official TypeSafe AI API key from https://console.typesafe.ai/home
# Powers Jev-AI (Bot-00) via System One (POST https://api.typesafe.ai/v1/systemone, model: "jev-latest").
# Add via Settings > Secrets in AI Studio or in your local .env / docker-compose.yml.
TYPESAFE_API_KEY=""

# TYPESAFE_API_URL: TypeSafe AI System One endpoint (defaults to https://api.typesafe.ai/v1/systemone)
TYPESAFE_API_URL="https://api.typesafe.ai/v1/systemone"

# TYPESAFE_MODEL: TypeSafe AI System One model alias (defaults to "jev-latest")
TYPESAFE_MODEL="jev-latest"

# JEV_AI_API_KEY: Supported alias for TYPESAFE_API_KEY
JEV_AI_API_KEY=""

# GEMINI_API_KEY: Secondary fallback API key if TYPESAFE_API_KEY is not yet configured.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"


